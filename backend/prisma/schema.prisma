generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  // If using Supabase and PgBouncer, uncomment this:
  // directUrl = env("DIRECT_URL")
}

model CategoryTypes {
  categoryTypeId   BigInt       @id @default(autoincrement())
  categoryTypeName String
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  categories       Categories[]
}

model Categories {
  categoryId        BigInt         @id @default(autoincrement())
  categoryName      String         @unique
  categoryType      BigInt
  type              CategoryTypes  @relation(fields: [categoryType], references: [categoryTypeId])
  categoryColorCode String
  transactions      Transactions[]
  credits           Credits[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([categoryType])
}

model Transactions {
  transactionId BigInt     @id @default(autoincrement())
  date          DateTime
  amount        Int // Rounded before save
  description   String?
  categoryId    BigInt
  category      Categories @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([date])
  @@index([transactionId])
}

model Credits {
  creditId        BigInt     @id @default(autoincrement())
  description     String
  categoryId      BigInt
  category        Categories @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
  billedDate      DateTime
  lastPaymentDate DateTime
  paidStatus      Boolean
  paymentDate     DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([categoryId])
}

view TransactionView {
  transactionId     BigInt   @unique
  amount            Int
  date              DateTime
  description       String?
  categoryId        BigInt
  categoryName      String
  categoryColorCode String
  categoryTypeName  String
}
