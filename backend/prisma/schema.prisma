// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["views"] 
}

datasource db {
  provider = "postgresql"
}

model Categories {
  categoryId        BigInt         @id @default(autoincrement())
  categoryName      String         @unique
  categoryType      BigInt
  categoryColorCode String
  transactions      Transactions[]
  credits           Credits[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model PushSubscriptions {
  id        BigInt   @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}


model Transactions {
  transactionId BigInt     @id @default(autoincrement())
  date          DateTime
  amount        BigInt
  description   String?
  categoryId    BigInt
  category      Categories @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([date])
  @@index([transactionId])
}

model Credits {
  creditId        BigInt     @id @default(autoincrement())
  description     String
  categoryId      BigInt
  amount          BigInt
  category        Categories @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
  billedDate      DateTime
  lastPaymentDate DateTime
  paidStatus      Boolean
  paymentDate     DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([categoryId])
}

view TransactionView {
  transactionId     BigInt   @unique @map("transactionId")
  amount            BigInt
  date              DateTime
  description       String?
  categoryId        BigInt
  categoryName      String
  categoryColorCode String
}

view CreditView {
  creditId          BigInt   @unique @map("creditId")
  amount            BigInt
  billedDate        DateTime
  lastPaymentDate   DateTime
  paidStatus        Boolean
  paymentDate       DateTime
  description       String?
  categoryId        BigInt
  categoryName      String
  categoryColorCode String
}
